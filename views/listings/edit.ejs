<% layout("/layouts/boilerplate") %>

<!-- Page Banner -->
<div class="page-banner">
  <div class="container">
    <div class="hh-hero-eyebrow" style="color:var(--gold);">
      <span style="width:28px;height:1px;background:var(--gold);display:inline-block;"></span>
      HavenHub
    </div>
    <h1>Edit Listing</h1>
    <p class="mt-2">Update the details of your property listing.</p>
  </div>
</div>

<!-- Form -->
<section class="form-page">
  <div class="container">
    <div class="form-card">

      <!-- Header -->
      <div class="form-card-header">
        <div class="form-eyebrow">Edit Listing</div>
        <h2><%= listing.title %></h2>
      </div>

      <!-- Body -->
      <form action="/listings/<%= listing._id %>?_method=PUT" 
        method="POST" 
        novalidate 
        class="needs-validation"
        enctype="multipart/form-data">
  
    <div class="form-card-body">
  
      <!-- Title -->
      <div class="form-group-hh">
        <label class="form-label-hh">
          Property Title <span class="label-required">*</span>
        </label>
        <input
          type="text"
          name="listing[title]"
          class="form-input-hh form-control"
          value="<%= listing.title %>"
          required
        >
        <div class="valid-feedback">
          Title looks good!
        </div>
        <div class="invalid-feedback">
          Please enter a title for the property.
        </div>
      </div>
  
      <!-- Description -->
      <div class="form-group-hh">
        <label class="form-label-hh">
          Description <span class="label-required">*</span>
        </label>
        <textarea
          name="listing[description]"
          class="form-input-hh form-control"
          required
        ><%= listing.description %></textarea>
        <div class="invalid-feedback">
          Please enter a valid description.
        </div>
      </div>
  
      <!-- Image URL -->
      <% if (listing.image && listing.image.url) { %>
        <div class="mb-3">
          <label class="form-label-hh">Current Image</label><br>
          <img 
            src="<%= originalImageUrl %>" 
            alt="Current Image" 
            style="width: 250px; height: 150px; object-fit: cover; border-radius: 10px;"
          >
        </div>
      <% } %>
      <div class="form-group-hh">
        <label class="form-label-hh">Upload New Image (optional)</label>
        <input
          type="file"
          name="listing[image]"
          class="form-input-hh form-control"
          placeholder="https://example.com/your-image.jpg"
        >
        <div class="invalid-feedback">
          Please enter a valid image URL.
        </div>
      </div>
  
      <!-- Price + Country -->
      <div class="form-row-grid">
  
        <!-- Price -->
        <div class="form-group-hh">
          <label class="form-label-hh">
            Price per Night (₹) <span class="label-required">*</span>
          </label>
          <input
            type="number"
            name="listing[price]"
            class="form-input-hh form-control"
            value="<%= listing.price %>"
            min="0"
            required
          >
          <div class="invalid-feedback">
            Please enter a valid price.
          </div>
        </div>
  
        <!-- Country -->
        <div class="form-group-hh">
          <label class="form-label-hh">
            Country <span class="label-required">*</span>
          </label>
          <input
            type="text"
            name="listing[country]"
            class="form-input-hh form-control"
            value="<%= listing.country %>"
            required
          >
          <div class="invalid-feedback">
            Please enter a valid country.
          </div>
        </div>
  
      </div>
  
      <!-- Location -->
      <div class="form-group-hh mb-0">
        <label class="form-label-hh">
          Location / City <span class="label-required">*</span>
        </label>
        <input
          type="text"
          name="listing[location]"
          class="form-input-hh form-control"
          value="<%= listing.location %>"
          required
        >
        <div class="invalid-feedback">
          Please enter a valid location.
        </div>
      </div>
  
    </div>
  
    <!-- Footer -->
    <div class="form-footer-hh">
      <a href="/listings/<%= listing._id %>" class="btn-form-cancel">
        <i class="bi bi-arrow-left"></i> Discard Changes
      </a>
      <button type="submit" class="btn-form-submit">
        <i class="bi bi-check-lg"></i> Save Changes
      </button>
    </div>
  </form>

    </div>
  </div>
</section>
