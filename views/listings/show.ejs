<div class="wl-toast" id="wl-toast"><i class="bi bi-check-circle-fill"></i> <span id="wl-toast-msg"></span></div>


<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
(() => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll('.wl-reveal').forEach(el => observer.observe(el));
})();

function toggleDesc() {
  const s = document.getElementById('wl-desc-short');
  const f = document.getElementById('wl-desc-full');
  const btn = document.getElementById('wl-desc-btn');
  const chevron = document.getElementById('wl-desc-chevron');
  const expanded = f.style.display !== 'none';
  s.style.display = expanded ? 'inline' : 'none';
  f.style.display = expanded ? 'none' : 'inline';
  btn.innerHTML = expanded ? 'Show more <i class="bi bi-chevron-down" id="wl-desc-chevron"></i>' : 'Show less <i class="bi bi-chevron-up" id="wl-desc-chevron"></i>';
}

function showToast(msg) {
  const toast = document.getElementById('wl-toast');
  document.getElementById('wl-toast-msg').textContent = msg;
  toast.classList.add('show');
  setTimeout(() => toast.classList.remove('show'), 3000);
}

function handleShare() {
  if (navigator.share) {
    navigator.share({ title: '<%= listing.title %>', url: window.location.href }).catch(() => {});
  } else {
    navigator.clipboard.writeText(window.location.href).then(() => showToast('Link copied to clipboard!'));
  }
}

function toggleSave(btn) {
  const saved = btn.classList.toggle('saved');
  btn.innerHTML = saved
    ? '<i class="bi bi-heart-fill" style="color:#e00b41"></i> Saved'
    : '<i class="bi bi-heart"></i> Save';
  showToast(saved ? 'Saved to your wishlist' : 'Removed from wishlist');
}

function handleReserve() {
  showToast('Booking flow coming soon!');
}

(() => {
  const form = document.querySelector('.needs-validation');
  if (!form) return;
  form.addEventListener('submit', e => {
    const textarea = form.querySelector('textarea');
    const ratingError = document.getElementById('ratingError');
    const commentError = document.getElementById('commentError');
    let valid = true;
    const ratingChecked = form.querySelector('input[name="review[rating]"]:checked');
    if (!ratingChecked) {
      ratingError.style.display = 'block';
      valid = false;
    } else {
      ratingError.style.display = 'none';
    }

    if (!textarea.value || textarea.value.trim().length < 5) {
      commentError.style.display = 'block';
      textarea.style.borderColor = '#dc3545';
      valid = false;
    } else {
      commentError.style.display = 'none';
      textarea.style.borderColor = '';
    }

    if (!valid) { e.preventDefault(); e.stopPropagation(); }
    form.classList.add('was-validated');
  });
})();
</script>

<% if (hasMap) { %>
<script>
(() => {
  const mapEl = document.getElementById("listing-map");
  const coords = JSON.parse(mapEl.dataset.coords);
  const lon = coords[0];
  const lat = coords[1];

  const map = L.map("listing-map").setView([lat, lon], 12);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: "&copy; OpenStreetMap contributors",
  }).addTo(map);

  L.circle([lat, lon], {
    radius: 1200,
    color: "#072252",
    fillColor: "#072252",
    fillOpacity: 0.2
  }).addTo(map);

  const airbnbIcon = L.divIcon({
    className: "airbnb-marker",
    html: `<div class="marker-wrapper"><i class="fa-brands fa-airbnb"></i><div class="pulse-ring"></div></div>`,
    iconSize: [40, 40],
    iconAnchor: [20, 40],
  });

  const marker = L.marker([lat, lon], { icon: airbnbIcon }).addTo(map);
  marker.on("click", () => map.flyTo([lat, lon], 15, { animate: true, duration: 1.5 }));
})();
</script>
<% } %>
