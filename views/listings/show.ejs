<% layout("/layouts/boilerplate") %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />

<style>
  .wl-show-page { background: #f7f5f0; min-height: 100vh; }

  .wl-breadcrumb {
    background: #fff;
    border-bottom: 1px solid rgba(0,0,0,0.07);
    padding: 0.7rem 0;
    position: sticky;
    top: 0;
    z-index: 200;
    backdrop-filter: blur(10px);
  }
  .wl-breadcrumb .breadcrumb { margin: 0; font-size: 0.8rem; }
  .wl-breadcrumb .breadcrumb-item a { color: #555; text-decoration: none; }
  .wl-breadcrumb .breadcrumb-item a:hover { color: #072252; text-decoration: underline; }
  .wl-breadcrumb .breadcrumb-item.active { color: #072252; font-weight: 500; }

  .wl-hero-bar {
    max-width: 1180px;
    margin: 2rem auto 0.85rem;
    padding: 0 1.25rem;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .wl-hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 700;
    color: #072252;
    margin: 0 0 0.3rem;
    line-height: 1.15;
  }
  .wl-hero-sub {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.88rem;
    color: #555;
  }
  .wl-hero-sub .wl-dot { color: #bbb; }
  .wl-hero-rating { display: flex; align-items: center; gap: 4px; font-weight: 600; color: #072252; }
  .wl-hero-rating .bi-star-fill { color: #c9a84c; font-size: 0.8rem; }
  .wl-hero-location { display: flex; align-items: center; gap: 4px; }
  .wl-hero-location .bi-geo-alt-fill { color: #1a7f7f; font-size: 0.8rem; }
  .wl-hero-actions { display: flex; gap: 0.4rem; flex-shrink: 0; }
  .wl-icon-btn {
    display: inline-flex; align-items: center; gap: 5px;
    background: transparent; border: none; padding: 0.45rem 0.85rem;
    border-radius: 8px; font-size: 0.85rem; font-weight: 500;
    color: #333; cursor: pointer; transition: background 0.2s;
    text-decoration: underline;
  }
  .wl-icon-btn:hover { background: rgba(0,0,0,0.06); }
  .wl-icon-btn.saved { color: #e00b41; }

  .wl-gallery-wrap {
    max-width: 1180px;
    margin: 0 auto 2rem;
    padding: 0 1.25rem;
  }
  .wl-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    border-radius: 18px;
    overflow: hidden;
    height: 470px;
  }
  .wl-gallery-main { overflow: hidden; cursor: pointer; position: relative; }
  .wl-gallery-main img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.55s ease;
    display: block;
  }
  .wl-gallery-main:hover img { transform: scale(1.04); }
  .wl-gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 8px;
  }
  .wl-gallery-thumb { position: relative; overflow: hidden; cursor: pointer; }
  .wl-gallery-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.55s ease; display: block; }
  .wl-gallery-thumb:hover img { transform: scale(1.07); }
  .wl-gallery-badge {
    position: absolute; bottom: 12px; right: 12px;
    background: rgba(255,255,255,0.95); border: 1.5px solid #072252;
    color: #072252; font-size: 0.78rem; font-weight: 700;
    padding: 0.4rem 0.95rem; border-radius: 8px;
    display: inline-flex; align-items: center; gap: 5px;
    cursor: pointer; transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  }
  .wl-gallery-badge:hover { background: #072252; color: #fff; }

  .wl-gallery-single {
    height: 470px; border-radius: 18px; overflow: hidden; cursor: pointer;
  }
  .wl-gallery-single img {
    width: 100%; height: 100%; object-fit: cover; transition: transform 0.55s ease; display: block;
  }
  .wl-gallery-single:hover img { transform: scale(1.03); }

  .wl-body-grid {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.25rem 5rem;
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3.5rem;
    align-items: start;
  }
  .wl-left { min-width: 0; }

  .wl-divider { height: 1px; background: rgba(0,0,0,0.08); margin: 0; }

  .wl-section { padding: 2rem 0; }
  .wl-basic-row {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .wl-section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem; font-weight: 700; color: #072252; margin: 0 0 0.25rem;
  }
  .wl-basic-sub { font-size: 0.88rem; color: #666; margin: 0; display: flex; flex-wrap: wrap; gap: 0.3rem; align-items: center; }
  .wl-host-avatar {
    width: 54px; height: 54px; border-radius: 50%;
    background: linear-gradient(135deg,#072252,#1a7f7f);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 1.3rem; font-weight: 700;
    border: 2px solid #c9a84c; flex-shrink: 0;
  }

  /* ── Highlights ── */
  .wl-highlights { display: flex; flex-direction: column; gap: 1.4rem; }
  .wl-hi-row { display: flex; align-items: flex-start; gap: 1.25rem; }
  .wl-hi-icon { font-size: 1.5rem; color: #072252; flex-shrink: 0; margin-top: 1px; }
  .wl-hi-title { font-weight: 600; font-size: 0.94rem; color: #111; margin: 0 0 2px; }
  .wl-hi-sub { font-size: 0.82rem; color: #777; margin: 0; line-height: 1.5; }

  /* ── Description ── */
  .wl-desc-text {
    font-size: 0.96rem; color: #333; line-height: 1.9; font-weight: 300;
  }
  .wl-desc-toggle {
    background: none; border: none; color: #072252; font-weight: 700;
    font-size: 0.9rem; cursor: pointer; padding: 0; text-decoration: underline;
    margin-top: 0.75rem; display: inline-flex; align-items: center; gap: 4px;
  }

  /* ── Amenities ── */
  .wl-amenities-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.6rem 2rem; margin-bottom: 1.5rem;
  }
  .wl-amenity {
    display: flex; align-items: center; gap: 0.75rem;
    font-size: 0.92rem; color: #333;
    padding: 0.55rem 0; border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .wl-amenity i { font-size: 1.1rem; color: #072252; }
  .wl-amenities-btn {
    background: transparent; border: 1.5px solid #072252;
    color: #072252; font-size: 0.86rem; font-weight: 700;
    padding: 0.7rem 1.4rem; border-radius: 8px; cursor: pointer; transition: all 0.2s;
  }
  .wl-amenities-btn:hover { background: #072252; color: #fff; }

  /* ── Map ── */
  .wl-map-sub { font-size: 0.87rem; color: #777; margin-bottom: 1rem; display: flex; align-items: center; gap: 5px; }
  .wl-map-sub .bi-geo-alt-fill { color: #1a7f7f; }
  #listing-map {
    width: 100%; height: 380px;
    border-radius: 18px; overflow: hidden;
    border: 1px solid rgba(0,0,0,0.09);
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
  }

  /* ── Things to know ── */
  .wl-ttk-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .wl-ttk-col h6 { font-size: 0.9rem; font-weight: 700; color: #072252; margin-bottom: 0.85rem; }
  .wl-ttk-col ul { list-style: none; padding: 0; margin: 0; }
  .wl-ttk-col ul li { font-size: 0.83rem; color: #555; padding: 0.35rem 0; border-bottom: 1px solid rgba(0,0,0,0.05); display: flex; align-items: center; gap: 6px; }
  .wl-ttk-col ul li i { font-size: 0.8rem; color: #999; }

  
  .wl-owner-actions {
    display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap;
    padding: 1.5rem; background: #fff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 16px; margin-top: 0.5rem;
  }
  .wl-owner-actions-title { font-size: 0.82rem; color: #888; margin-bottom: 0.75rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; }
  .btn-wl-edit {
    display: inline-flex; align-items: center; gap: 6px;
    background: #072252; color: #fff; font-size: 0.86rem; font-weight: 600;
    padding: 0.65rem 1.4rem; border-radius: 10px; text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-wl-edit:hover { background: #0a3580; color: #fff; transform: translateY(-1px); }
  .btn-wl-delete {
    display: inline-flex; align-items: center; gap: 6px;
    background: transparent; border: 1.5px solid #dc3545; color: #dc3545;
    font-size: 0.86rem; font-weight: 600; padding: 0.65rem 1.4rem;
    border-radius: 10px; cursor: pointer; transition: all 0.2s;
  }
  .btn-wl-delete:hover { background: #dc3545; color: #fff; }
  .btn-wl-back {
    display: inline-flex; align-items: center; gap: 6px;
    background: transparent; border: 1.5px solid rgba(0,0,0,0.15); color: #555;
    font-size: 0.86rem; font-weight: 500; padding: 0.65rem 1.4rem;
    border-radius: 10px; text-decoration: none; transition: all 0.2s;
  }
  .btn-wl-back:hover { border-color: #072252; color: #072252; }

  .wl-booking-card-wrap { position: sticky; top: 80px; }
  .wl-booking-card {
    background: #fff;
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 20px;
    padding: 1.75rem;
    box-shadow: 0 8px 40px rgba(0,0,0,0.1);
  }
  .wl-bk-price-row { display: flex; align-items: baseline; gap: 6px; margin-bottom: 1.4rem; }
  .wl-bk-price { font-size: 1.55rem; font-weight: 800; color: #072252; }
  .wl-bk-night { font-size: 0.88rem; color: #777; }
  .wl-bk-rating { display: flex; align-items: center; gap: 5px; font-size: 0.84rem; margin-bottom: 1.4rem; }
  .wl-bk-rating .bi-star-fill { color: #c9a84c; }
  .wl-bk-dates {
    display: grid; grid-template-columns: 1fr 1fr;
    border: 1.5px solid #ddd; border-radius: 12px;
    overflow: hidden; margin-bottom: 0;
  }
  .wl-bk-date-field {
    padding: 0.85rem 1rem; cursor: pointer; transition: background 0.2s;
    border-right: 1px solid #ddd;
  }
  .wl-bk-date-field:last-child { border-right: none; }
  .wl-bk-date-field:hover { background: #f7f5f0; }
  .wl-bk-date-label { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #333; margin: 0 0 2px; }
  .wl-bk-date-val { font-size: 0.85rem; color: #888; margin: 0; }
  .wl-bk-guests {
    border: 1.5px solid #ddd; border-top: none;
    border-radius: 0 0 12px 12px;
    padding: 0.85rem 1rem; cursor: pointer;
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 1.25rem; transition: background 0.2s;
  }
  .wl-bk-guests:hover { background: #f7f5f0; }
  .wl-bk-guests-left { }
  .wl-bk-guests-label { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #333; margin: 0 0 2px; }
  .wl-bk-guests-val { font-size: 0.85rem; color: #888; margin: 0; }
  .wl-bk-reserve-btn {
    width: 100%; background: linear-gradient(135deg, #e00b41, #b5093a);
    color: #fff; font-size: 1rem; font-weight: 700;
    padding: 1rem; border: none; border-radius: 12px;
    cursor: pointer; transition: all 0.22s;
    box-shadow: 0 4px 16px rgba(224,11,65,0.3);
    letter-spacing: 0.02em;
  }
  .wl-bk-reserve-btn:hover { background: linear-gradient(135deg, #c5093a, #9c0830); transform: translateY(-1px); box-shadow: 0 6px 22px rgba(224,11,65,0.38); }
  .wl-bk-note { font-size: 0.78rem; color: #999; text-align: center; margin-top: 0.7rem; }
  .wl-bk-fee-row { display: flex; justify-content: space-between; font-size: 0.87rem; color: #555; margin-top: 1.1rem; padding-top: 1.1rem; border-top: 1px solid rgba(0,0,0,0.08); }
  .wl-bk-fee-total { font-weight: 700; color: #072252; }

  
  .wl-contact-host {
    margin-top: 1rem;
    padding: 1.25rem 1.5rem;
    background: #fff; border: 1px solid rgba(0,0,0,0.08);
    border-radius: 16px; text-align: center;
  }
  .wl-contact-host .wl-ch-icon { font-size: 2rem; color: #c9a84c; margin-bottom: 0.5rem; }
  .wl-contact-host p { font-size: 0.83rem; color: #666; margin-bottom: 0.75rem; }
  .wl-contact-host button {
    background: transparent; border: 1.5px solid #072252; color: #072252;
    font-size: 0.85rem; font-weight: 700; padding: 0.55rem 1.25rem;
    border-radius: 8px; cursor: pointer; transition: all 0.2s; width: 100%;
  }
  .wl-contact-host button:hover { background: #072252; color: #fff; }

  .wl-reviews-section {
    max-width: 1180px; margin: 0 auto; padding: 0 1.25rem 5rem;
  }

  /* ── Review stats header ── */
  .wl-rev-header {
    display: flex; align-items: center; gap: 0.7rem; margin-bottom: 2rem;
  }
  .wl-rev-star-big { color: #c9a84c; font-size: 1.3rem; }
  .wl-rev-avg { font-size: 1.5rem; font-weight: 800; color: #072252; }
  .wl-rev-dot { color: #ccc; }
  .wl-rev-count { font-size: 1rem; color: #555; }

  /* ── Review grid ── */
  .wl-rev-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 2.5rem; }

  .wl-rev-card {
    background: #fff; border: 1px solid rgba(0,0,0,0.07);
    border-radius: 16px; padding: 1.4rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.05);
    transition: box-shadow 0.25s, transform 0.25s;
    position: relative;
  }
  .wl-rev-card:hover { box-shadow: 0 6px 24px rgba(0,0,0,0.1); transform: translateY(-2px); }

  .wl-rev-card-top { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 0.85rem; }
  .wl-rev-avatar {
    width: 44px; height: 44px; border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #072252, #1a7f7f);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-weight: 700; font-size: 1.05rem;
  }
  .wl-rev-name { font-weight: 700; font-size: 0.92rem; color: #111; margin: 0 0 2px; }
  .wl-rev-date { font-size: 0.76rem; color: #aaa; margin: 0; }
  .wl-rev-stars { display: flex; gap: 2px; margin-bottom: 0.75rem; }
  .wl-rev-stars .bi-star-fill { color: #c9a84c; font-size: 0.75rem; }
  .wl-rev-stars .bi-star { color: #ddd; font-size: 0.75rem; }
  .wl-rev-comment { font-size: 0.9rem; color: #444; line-height: 1.7; margin: 0; }
  .wl-rev-delete-btn {
    position: absolute; bottom: 1rem; right: 1rem;
    background: transparent; border: 1px solid #ddd;
    color: #999; font-size: 0.76rem; padding: 0.3rem 0.7rem;
    border-radius: 6px; cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; gap: 4px;
  }
  .wl-rev-delete-btn:hover { border-color: #dc3545; color: #dc3545; }

  /* ── Empty reviews state ── */
  .wl-rev-empty {
    text-align: center; padding: 3rem 1.5rem;
    border: 2px dashed rgba(0,0,0,0.1); border-radius: 16px;
    margin-bottom: 2.5rem;
  }
  .wl-rev-empty-icon { font-size: 2.5rem; color: #c9a84c; margin-bottom: 1rem; }
  .wl-rev-empty h5 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem; font-weight: 700; color: #072252; margin-bottom: 0.4rem;
  }
  .wl-rev-empty p { font-size: 0.88rem; color: #999; }

  /* ── Review form ── */
  .wl-rev-form-wrap {
    background: #fff; border: 1px solid rgba(0,0,0,0.08);
    border-radius: 20px; padding: 2rem;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .wl-rev-form-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem; font-weight: 700; color: #072252;
    margin-bottom: 0.35rem;
  }
  .wl-rev-form-sub { font-size: 0.85rem; color: #999; margin-bottom: 1.5rem; }
  .wl-rev-textarea {
    width: 100%; border: 1.5px solid rgba(0,0,0,0.12); border-radius: 12px;
    padding: 1rem 1.1rem; font-size: 0.93rem; color: #333; resize: vertical;
    min-height: 130px; outline: none; transition: border-color 0.2s;
    font-family: inherit; background: #fdfcfa;
  }
  .wl-rev-textarea:focus { border-color: #072252; background: #fff; }
  .wl-rev-submit-btn {
    background: #072252; color: #fff; border: none;
    font-size: 0.92rem; font-weight: 700;
    padding: 0.85rem 2rem; border-radius: 10px;
    cursor: pointer; transition: all 0.22s;
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 1rem;
  }
  .wl-rev-submit-btn:hover { background: #0a3580; transform: translateY(-1px); }
  .wl-rev-textarea-label { font-size: 0.83rem; font-weight: 700; color: #444; margin-bottom: 0.5rem; display: block; letter-spacing: 0.02em; }

  .wl-rating-section { margin-bottom: 1.25rem; }
  .wl-rating-label { font-size: 0.83rem; font-weight: 700; color: #444; margin-bottom: 0.6rem; display: block; letter-spacing: 0.02em; }
  .wl-star-picker { display: flex; flex-direction: row-reverse; justify-content: flex-end; gap: 4px; }
  .wl-star-picker input[type="radio"] { display: none; }
  .wl-star-picker label { font-size: 1.75rem; cursor: pointer; color: #ddd; transition: color 0.12s; line-height: 1; }
  .wl-star-picker label:hover,
  .wl-star-picker label:hover ~ label { color: #c9a84c; }
  .wl-star-picker input:checked + label,
  .wl-star-picker input:checked + label ~ label { color: #c9a84c; }

  .wl-toast {
    position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%) translateY(10px);
    background: #072252; color: #fff; font-size: 0.88rem; font-weight: 600;
    padding: 0.75rem 1.5rem; border-radius: 50px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    opacity: 0; pointer-events: none; z-index: 9999;
    transition: opacity 0.3s, transform 0.3s;
    display: flex; align-items: center; gap: 8px;
  }
  .wl-toast.show { opacity: 1; pointer-events: auto; transform: translateX(-50%) translateY(0); }

  @media (max-width: 1024px) {
    .wl-body-grid { grid-template-columns: 1fr; gap: 2rem; }
    .wl-booking-card-wrap { position: static; }
    .wl-booking-card { max-width: 520px; }
    .wl-rev-grid { grid-template-columns: 1fr 1fr; }
    .wl-ttk-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .wl-gallery { grid-template-columns: 1fr; height: 300px; }
    .wl-gallery-grid { display: none; }
    .wl-gallery-main { border-radius: 0; }
    .wl-rev-grid { grid-template-columns: 1fr; }
    .wl-ttk-grid { grid-template-columns: 1fr; }
    .wl-hero-bar { margin-top: 1.2rem; }
    .wl-hero-title { font-size: 1.5rem; }
    .wl-booking-card { max-width: 100%; }
    .wl-amenities-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .wl-gallery-single { height: 240px; }
    .wl-bk-dates { grid-template-columns: 1fr; }
    .wl-bk-date-field { border-right: none; border-bottom: 1px solid #ddd; }
  }

  .wl-reveal {
    opacity: 0; transform: translateY(22px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .wl-reveal.visible { opacity: 1; transform: translateY(0); }
</style>

<div class="wl-show-page">

  <div class="wl-breadcrumb">
    <div class="container">
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a href="/"><i class="bi bi-house me-1"></i>Home</a></li>
          <li class="breadcrumb-item"><a href="/listings">Listings</a></li>
          <li class="breadcrumb-item active"><%= listing.title %></li>
        </ol>
      </nav>
    </div>
  </div>

  <div class="wl-hero-bar wl-reveal">
    <div>
      <h1 class="wl-hero-title"><%= listing.title %></h1>
      <div class="wl-hero-sub">
        <span class="wl-hero-rating">
          <i class="bi bi-star-fill"></i> 4.9
        </span>
        <span class="wl-dot">·</span>
        <span><u style="cursor:pointer;" onclick="document.getElementById('wl-reviews-anchor').scrollIntoView({behavior:'smooth'})">
          <%= (listing.reviews || []).length %> review<%= (listing.reviews || []).length !== 1 ? 's' : '' %>
        </u></span>
        <span class="wl-dot">·</span>
        <span class="wl-hero-location">
          <i class="bi bi-geo-alt-fill"></i>
          <%= listing.location %>, <%= listing.country %>
        </span>
      </div>
    </div>

    <div class="wl-hero-actions">
      <button class="wl-icon-btn" id="wl-share-btn" onclick="handleShare()">
        <i class="bi bi-box-arrow-up"></i> Share
      </button>
      <button class="wl-icon-btn" id="wl-save-btn" onclick="toggleSave(this)">
        <i class="bi bi-heart"></i> Save
      </button>
    </div>
  </div>

  <%
